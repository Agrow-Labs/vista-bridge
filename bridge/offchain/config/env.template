# VISTA Bridge Configuration Template
# Copy this content to a .env file in the root directory and populate with your actual values

# Source Network (where deposits are watched)
SOURCE_NETWORK_NAME=preproduction
SOURCE_UTXORPC_URL=https://preprod.utxorpc-v0.demeter.run
SOURCE_UTXORPC_API_KEY=your_demeter_api_key_here
SOURCE_LUCID_PROVIDER=https://preprod.koios.rest/api/v1
SOURCE_LUCID_NETWORK=Preproduction
# Comma-separated list of addresses to watch for deposits
SOURCE_DEPOSIT_ADDRESSES=addr_test1qpnueplse6f4d55eumh7f3tzp3wx882xk7qs6ydxtynrfsw89vzfjf0v4yca056el40n7pr568rdls6lp6eu0dwek9nqku88yp

# Destination Network (where mirror transactions are sent)
DEST_NETWORK_NAME=preview  
DEST_UTXORPC_URL=https://preview.utxorpc-v0.demeter.run
DEST_UTXORPC_API_KEY=your_demeter_api_key_here
DEST_LUCID_PROVIDER=https://preview.koios.rest/api/v1
DEST_LUCID_NETWORK=Preview
# Comma-separated list of sender addresses for mirror transactions
DEST_SENDER_ADDRESSES=addr_test1qpg5fj3gsmt673lpxlpzhum6mrw2z0hyk3u455swep39zdt6yr3r556e70k6uvrj8jyey6jwnaeamenujatxuqs50ljq2mq4xl

# Bridge Configuration
BRIDGE_ALLOWED_ASSETS=ADA
BRIDGE_MIN_DEPOSIT_AMOUNT=2000000
BRIDGE_MAX_TRANSFER_AMOUNT=100000000000
BRIDGE_FEE_AMOUNT=1000000

# Security Settings
SECURITY_REQUIRED_CONFIRMATIONS=5
SECURITY_RETRY_ATTEMPTS=3
SECURITY_RETRY_DELAY_MS=5000

# gRPC Service Ports
GRPC_INDEXER_PORT=50051
GRPC_RELAYER_PORT=50052
GRPC_MIRROR_PORT=50053

# HTTP API
API_PORT=3001

# Note: Get your Demeter API keys from https://demeter.run
# Each network needs its own API key and endpoint

# ── EVM bridge (e.g. ETH Sepolia <-> Cardano Preprod) ─────────────────
# Activate the example config:
#   BRIDGE_ROUTES_FILE=config/routes.eth-example.json
#
# Per-route secrets. The route id "eth-sepolia-to-preprod" becomes the env prefix
# ROUTE_ETH_SEPOLIA_TO_PREPROD_*  (uppercased, hyphens → underscores).
#
# Get an Alchemy API key (free, Sepolia): https://www.alchemy.com (recommended primary).
# Fallback: dRPC public WSS at wss://ethereum-sepolia.publicnode.com (no key, lower limits).
#
# ── eth-sepolia-to-preprod (ETH → Cardano direction) ────────────────
ROUTE_ETH_SEPOLIA_TO_PREPROD_SOURCE_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ROUTE_ETH_SEPOLIA_TO_PREPROD_SOURCE_WS_URL=wss://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Mirror-side: Cardano destination wallet seed (signs the mint tx)
ROUTE_ETH_SEPOLIA_TO_PREPROD_DEST_WALLET_SEED=word1 word2 ... word24
ROUTE_ETH_SEPOLIA_TO_PREPROD_DEST_API_KEY=your_demeter_preprod_key

# ── preprod-to-eth-sepolia (Cardano → ETH direction) ────────────────
ROUTE_PREPROD_TO_ETH_SEPOLIA_SOURCE_API_KEY=your_demeter_preprod_key
# Cardano source wallet seed (signs vETH burn tx, needed because sourceAction=burn)
ROUTE_PREPROD_TO_ETH_SEPOLIA_SOURCE_WALLET_SEED=word1 word2 ... word24
# EVM destination: ethers wallet that holds Sepolia ETH for outbound mirrors.
# Fund this address at https://sepolia-faucet.pk910.de/ or https://cloud.google.com/application/web3/faucet/ethereum/sepolia
ROUTE_PREPROD_TO_ETH_SEPOLIA_DEST_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ROUTE_PREPROD_TO_ETH_SEPOLIA_DEST_WS_URL=wss://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ROUTE_PREPROD_TO_ETH_SEPOLIA_DEST_PRIVATE_KEY=0xYOUR_HEX_PRIVATE_KEY 